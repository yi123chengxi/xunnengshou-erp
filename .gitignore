# ========================
# 依赖目录
# ========================
node_modules/
client/node_modules/
server/node_modules/
print-client/node_modules/

# ========================
# 环境变量（含敏感凭证）
# ========================
.env
.env.local
.env.*.local
server/.env
client/.env

# ========================
# 数据库文件
# ========================
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal
server/data/sync/
server/data/registeredUsers.json

# ========================
# 构建产物
# ========================
server/dist/
client/build/
print-client/dist/
print-client/out/
print-client/release/

# ========================
# 上传文件 & 下载包
# ========================
server/uploads/
server/downloads/*.exe
client/public/downloads/*.exe

# ========================
# 根目录截图和图片（开发过程产物）
# ========================
/*.png
/*.jpeg
/*.jpg
/*.bmp
/*.gif

# ========================
# 根目录文档文件
# ========================
/*.md
!README.md
/*.xlsx
/*.xls
/*.doc
/*.docx
/*.pdf

# ========================
# 根目录测试/临时脚本
# ========================
/*.js
!ecosystem.config.js
# 部署临时产物（SFTP 上传用的打包 tar、临时脚本与输出）
/*.tar.gz
/deploy-stage/

# ========================
# 目录：验证截图 & 工作区
# ========================
/verify_screenshots/
/workspace/

# ========================
# IDE & 编辑器
# ========================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ========================
