{
  "name": "factory-print-client",
  "version": "1.0.6",
  "description": "讯能手 ERP 本地打印客户端",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc && npm run build:renderer",
    "build:renderer": "esbuild src/renderer/renderer.tsx --bundle --outfile=dist/renderer/renderer.js --platform=browser --format=iife --jsx=automatic",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "antd": "^5.12.0",
    "electron-updater": "^6.8.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.3.2"
  },
  "build": {
    "appId": "com.xunnengshou.print-client",
    "productName": "讯能手打印客户端",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "artifactName": "xunnengshou-print-client-setup.exe",
    "publish": {
      "provider": "generic",
      "url": "http://127.0.0.1/downloads/"
    }
  }
}
